{
    "name": "3brs/sylius-analytics-plugin",
    "description": "Analytics tracking plugin for Sylius front store and product views.",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.1"
    },
    "require-dev": {
        "behat/behat": "^3.34 || ^4.0",
